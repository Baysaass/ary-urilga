# ==============================================================================
# Vercel & Supabase Environment Variables
# Vercel дээр байршуулах үед "Project Settings" -> "Environment Variables" хэсэгт оруулна.
# ==============================================================================

# 1. Supabase холболтын мэдээлэл (Supabase Dashboard -> Settings -> API хэсгээс авна)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-api-key"

# 2. Гэрийн эзний удирдах самбарын ПИН код (Сонголттой, анхдагч нь 2026)
VITE_ADMIN_PIN="2026"

# 3. Express локал сервер ашиглах бол (Сонголттой)
PORT=3000
ADMIN_PIN="2026"
